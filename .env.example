# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SUPERADMIN_USER_IDS=user_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/logowanie
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/rejestracja
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/panel
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=warstwowe_saas
# Opcjonalnie: resolver DNS dla mongodb+srv, np. gdy Windows blokuje zapytania SRV.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Stripe (use sk_test_ locally and sk_live_ in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel jobs and storage
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=

# Transactional e-mail (Webd SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Konfigurator <noreply@twoja-domena.pl>
MAIL_REPLY_TO=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
DEMO_MODE=true
