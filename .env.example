# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SUPERADMIN_USER_IDS=user_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/logowanie
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/rejestracja
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=warstwowe_saas

# PayU (Sandbox by default)
PAYU_ENV=sandbox
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_POS_ID=
NEXT_PUBLIC_PAYU_POS_ID=
NEXT_PUBLIC_PAYU_ENV=sandbox
PAYU_SECOND_KEY=

# Vercel jobs and storage
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=

# Transactional e-mail (Webd SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Konfigurator <noreply@twoja-domena.pl>
MAIL_REPLY_TO=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
